# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings (personal, must never be committed)
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

## Xcode 3/4 leftovers
build/
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# macOS
.DS_Store

# Swift Package Manager
.build/
.swiftpm/

# CocoaPods
#
# This project commits the Pods/ directory on purpose (the build depends on it
# and `pod install` is not always available). Do NOT ignore Pods/ unless you
# re-add it and verify `pod install` works in your environment.
# Pods/

# Carthage
Carthage/Build/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Code Injection
iOSInjectionProject/
